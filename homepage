<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Walkin' - ReDefine Fashion: Wear Your Story. Shop the latest trends and featured collections.">
    <title>Axn Walkin' - Home</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        html { box-sizing: border-box; }
        *, *:before, *:after { box-sizing: inherit; }
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: #111;
            color: #f7f7f7;
            min-height: 100vh;
        }
        header {
            background: #181818;
            color: #fff;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #232323;
        }
        .logo {
            font-size: 2em;
            font-weight: bold;
            letter-spacing: 1px;
            color: #fff;
        }
        nav ul {
            list-style: none;
            display: flex;
            gap: 18px;
            padding: 0;
            margin: 0;
        }
        nav ul li a {
            color: #f7f7f7;
            text-decoration: none;
            font-weight: 600;
            padding: 7px 13px;
            border-radius: 5px;
            transition: background 0.18s;
        }
        nav ul li a:hover,
        nav ul li a:focus {
            background: #232323;
        }
        main {
            display: flex;
            flex-direction: column;
            gap: 2.5em;
        }
        .hero {
            position: relative;
            text-align: center;
            padding: 100px 20px 60px 20px;
            background: #181818;
            color: #fff;
        }
        .hero h1 {
            font-size: 2.7em;
            margin-bottom: 0.5em;
            text-shadow: 0 2px 12px rgba(0,0,0,0.22);
            font-weight: bold;
        }
        .hero p {
            font-size: 1.6em;
            margin-bottom: 1.5em;
            background: rgba(36,36,36,0.7);
            display: inline-block;
            padding: 8px 24px;
            border-radius: 12px;
            color: #fff;
            font-weight: 600;
            border: 3px solid #fff; /* White border */
            box-shadow: 0 0 12px 2px #fff4; /* Subtle white glow for more pop */
            /* For a different color, change #fff above to your preferred accent */
        }
        .hero .btn {
            background: linear-gradient(90deg, #6dd5ed, #b621fe);
            color: #fff;
            padding: 13px 28px;
            text-decoration: none;
            font-size: 1.1em;
            border-radius: 30px;
            font-weight: bold;
            border: none;
            box-shadow: 0 2px 10px #000c;
            cursor: pointer;
            transition: filter 0.15s;
        }
        .hero .btn:hover, .hero .btn:focus {
            filter: brightness(1.2);
        }
        .hero video {
            width: 60vw;
            max-width: 620px;
            margin: 35px auto 0 auto;
            display: block;
            border-radius: 16px;
            box-shadow: 0 3px 30px #000a;
            border: 4px solid transparent;
            background:
                linear-gradient(90deg, #6dd5ed, #b621fe) border-box;
            border-image: linear-gradient(90deg, #6dd5ed, #b621fe) 1;
        }
        section {
            padding: 40px 20px 30px 20px;
            text-align: center;
        }
        h2 {
            font-size: 2em;
            margin-bottom: 1.3em;
            color: #fff;
            font-weight: bold;
        }
        .category-grid, .plant-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 22px;
            justify-content: center;
        }
        .category-item, .plant-item {
            background: #181818;
            border-radius: 16px;
            width: 230px;
            max-width: 93vw;
            min-width: 160px;
            margin-bottom: 12px;
            padding: 15px 12px 18px 12px;
            box-shadow: 0 2px 12px #000a;
            transition: box-shadow 0.2s, transform 0.17s;
            text-decoration: none;
            color: #fff;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .category-item:hover, .plant-item:hover {
            box-shadow: 0 4px 24px #6dd5ed55;
            transform: translateY(-4px) scale(1.03);
        }
        .category-item img, .plant-item img {
            max-width: 100%;
            height: auto;
            border-radius: 12px;
            border: 4px solid transparent;
            background: linear-gradient(90deg, #6dd5ed, #b621fe, #21d4fd) border-box;
            border-image: linear-gradient(90deg, #6dd5ed, #b621fe, #21d4fd) 1;
            margin-bottom: 13px;
            box-shadow: 0 1px 8px #000c;
        }
        .category-item h3, .plant-item h3 {
            font-size: 1.1em;
            margin: 9px 0 0 0;
            color: #fafafa;
            font-weight: bold;
            letter-spacing: 0.5px;
        }
        .plant-item h3 {
            color: #6dd5ed;
        }
        .plant-item p {
            font-size: 1em;
            color: #bbb;
        }
        footer {
            background: #181818;
            color: #eee;
            text-align: center;
            padding: 22px 0 10px 0;
            margin-top: 30px;
        }
        .social-icons {
            display: flex;
            justify-content: center;
            gap: 24px;
            margin-top: 10px;
        }
        .social-icons a {
            color: #6dd5ed;
            font-size: 1.6em;
            transition: color 0.2s, transform 0.2s;
        }
        .social-icons a:hover, .social-icons a:focus {
            color: #b621fe;
            transform: scale(1.12) rotate(-3deg);
        }
        @media (max-width: 900px) {
            .category-grid, .plant-grid {
                flex-direction: column;
                align-items: center;
            }
            .category-item, .plant-item {
                width: 85vw;
            }
            .hero h1 { font-size: 2em; }
            .hero p { font-size: 1.1em; }
        }
        @media (max-width: 600px) {
            header { flex-direction: column; gap: 10px; }
            .hero { padding: 60px 7px 40px 7px;}
            h2 { font-size: 1.25em;}
        }
    </style>
</head>
<body>
    <header role="banner">
        <div class="logo">Walkin'</div>
        <nav aria-label="Main Navigation">
            <ul>
                <li><a href="#about">About Us</a></li>
                <li><a href="#terms">Terms Of Service</a></li>
                <li><a href="#refund">Refund Policy</a></li>
                <li><a href="#contact">Contact Us</a></li>
                <li><a href="#signin">Sign In</a></li>
            </ul>
        </nav>
    </header>
    <main>
        <section class="hero" aria-label="Welcome Section">
            <h1>Welcome to Walkin'</h1>
            <p>ReDefine Fashion: Wear Your Story</p>
            <a href="#shop" class="btn">Shop Now</a>
            <video muted autoplay playsinline loop aria-label="Fashion Promo Video">
                <source src="https://cdn.shopify.com/videos/c/o/v/9954873ebd604484b1f336c036651cb4.mp4" type="video/mp4">
                Your browser does not support the video tag.
            </video>
        </section>
        <section class="categories" id="shop" aria-label="Shop by Category">
            <h2>Shop by Category</h2>
            <div class="category-grid">
                <a href="#fresh-hot" class="category-item">
                    <img src="https://www.prada.com/content/dam/pradabkg_products/U/UGI/UGI302/11A6F0192/UGI302_11A6_F0192_S_OOO_SLF.jpg" alt="Fresh & Hot Collection">
                    <h3>Fresh & Hot</h3>
                </a>
                <a href="#wardrobe" class="category-item">
                    <img src="https://www.prada.com/content/dam/pradabkg_products/U/UJL/UJL72B/15DAF035G/UJL72B_15DA_F035G_S_OOO_SLF.jpg" alt="Refill your Wardrobe">
                    <h3>Refill your Wardrobe</h3>
                </a>
                <a href="#tees" class="category-item">
                    <img src="https://www.prada.com/content/dam/pradabkg_products/U/UJN/UJN861/240F0E1D/UJN861_240_F0E1D_S_232_SLF.jpg" alt="Tees Collection">
                    <h3>Tees</h3>
                </a>
                <a href="#trousers" class="category-item">
                    <img src="https://www.prada.com/content/dam/pradabkg_products/S/SPH/SPH415/148UF0D65/SPH415_148U_F0D65_S_OOO_SLF.jpg" alt="Trousers Collection">
                    <h3>Trousers</h3>
                </a>
            </div>
        </section>
        <section class="featured-plants" aria-label="Featured Products">
            <h2>Featured</h2>
            <div class="plant-grid">
                <a href="#moonlight" class="plant-item">
                    <img src="https://www.jaywalking.in/cdn/shop/files/MOONLIGHT3.png?v=1717667289&width=1080" alt="MOONLIGHT TIE DYE">
                    <h3>MOONLIGHT TIE DYE</h3>
                </a>
                <a href="#stone" class="plant-item">
                    <img src="https://www.jaywalking.in/cdn/shop/files/stonetiedye2.png?v=1722070890&width=1080" alt="STONE TIE DYE">
                    <h3>STONE TIE DYE</h3>
                </a>
                <a href="#badly-scanned-logo" class="plant-item">
                    <img src="https://www.jaywalking.in/cdn/shop/files/logobadlyscanned4.png?v=1716973341&width=1080" alt="Badly Scanned Logo T-Shirt">
                    <h3>Badly Scanned Logo T-Shirt</h3>
                </a>
            </div>
        </section>
    </main>
    <footer>
        <p>&copy; 2024 Walkin' Ltd. All rights reserved.</p>
        <div class="social-icons" aria-label="Social Links">
            <a href="https://www.facebook.com" target="_blank" rel="noopener" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
            <a href="https://www.twitter.com" target="_blank" rel="noopener" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
            <a href="https://www.instagram.com" target="_blank" rel="noopener" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
        </div>
    </footer>
</body>
</html>
