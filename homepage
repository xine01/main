<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Walkin' - ReDefine Fashion: Wear Your Story. Shop the latest trends and featured collections.">
    <title>Axn Walkin' - Home</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        body {
            background: #111;
            color: #f7f7f7;
            font-family: 'Segoe UI', Arial, sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }
        header {
            background: #181818;
            color: #fff;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #222;
        }
        .logo {
            font-size: 2em;
            font-weight: bold;
            letter-spacing: 1px;
            color: #fff;
        }
        nav ul {
            list-style: none;
            display: flex;
            gap: 18px;
            padding: 0;
            margin: 0;
        }
        nav ul li a {
            color: #f7f7f7;
            text-decoration: none;
            font-weight: 500;
            padding: 7px 13px;
            border-radius: 5px;
            transition: background 0.18s;
        }
        nav ul li a:hover,
        nav ul li a:focus {
            background: #232323;
        }
        .hero {
            text-align: center;
            padding: 70px 15px 40px 15px;
            background: #131313;
        }
        .hero h1 {
            font-size: 2.5em;
            margin-bottom: 0.4em;
            letter-spacing: 1px;
        }
        .hero p {
            font-size: 1.3em;
            color: #fff;
            margin-bottom: 1.5em;
            background: rgba(36,36,36,0.7);
            display: inline-block;
            padding: 12px 32px;
            border-radius: 16px;
            font-weight: 700;
            border: 3px solid #fff;
            box-shadow: 0 0 12px 3px #fff4;
            position: relative;
            animation: blink-border 1.4s infinite cubic-bezier(.6,0,.6,1);
        }
        @keyframes blink-border {
            0%   { box-shadow: 0 0 12px 3px #fff4, 0 0 0px #6dd5ed33; border-color: #fff; }
            50%  { box-shadow: 0 0 24px 7px #6dd5edaa, 0 0 16px #fff7; border-color: #6dd5ed; }
            100% { box-shadow: 0 0 12px 3px #fff4, 0 0 0px #6dd5ed33; border-color: #fff; }
        }
        .hero video {
            width: 60vw;
            max-width: 400px;
            margin: 32px auto 0 auto;
            display: block;
            border-radius: 18px;
            box-shadow: 0 6px 36px #000a;
            border: 3px solid transparent;
            background: linear-gradient(90deg, #6dd5ed, #b621fe) border-box;
            border-image: linear-gradient(90deg, #6dd5ed, #b621fe) 1;
        }
        .hero .btn {
            background: linear-gradient(90deg, #6dd5ed, #b621fe);
            color: #fff;
            padding: 13px 30px;
            text-decoration: none;
            font-size: 1.1em;
            font-weight: bold;
            border: none;
            border-radius: 26px;
            transition: filter 0.2s;
            box-shadow: 0 2px 10px #111b;
            cursor: pointer;
            margin-top: 32px;
            display: inline-block;
        }
        .hero .btn:hover,
        .hero .btn:focus {
            filter: brightness(1.2);
        }
        section {
            padding: 35px 12px 24px 12px;
            text-align: center;
        }
        h2 {
            font-size: 1.5em;
            margin-bottom: 1.1em;
            color: #fff;
        }
        .category-grid, .plant-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 24px;
            justify-content: center;
        }
        .category-item, .plant-item {
            background: #181818;
            border-radius: 16px;
            width: 220px;
            max-width: 92vw;
            min-width: 140px;
            margin-bottom: 12px;
            padding: 17px 10px 14px 10px;
            box-shadow: 0 2px 18px #0007;
            transition: box-shadow 0.18s, transform 0.18s;
            text-decoration: none;
            color: #fff;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .category-item:hover,
        .plant-item:hover {
            box-shadow: 0 8px 28px #6dd5ed55;
            transform: translateY(-3px) scale(1.025);
        }
        .category-item img, .plant-item img {
            width: 100%;
            height: auto;
            border-radius: 12px;
            border: 3px solid transparent;
            background: linear-gradient(90deg, #6dd5ed, #b621fe) border-box;
            border-image: linear-gradient(90deg, #6dd5ed, #b621fe) 1;
            box-shadow: 0 1px 8px #000c;
            margin-bottom: 13px;
        }
        .category-item h3, .plant-item h3 {
            font-size: 1.08em;
            margin: 9px 0 0 0;
            color: #fafafa;
            font-weight: bold;
            letter-spacing: 0.5px;
        }
        .plant-item h3 {
            color: #6dd5ed;
        }
        .plant-item p {
            font-size: 1em;
            color: #bbb;
        }
        footer {
            background: #181818;
            color: #eee;
            text-align: center;
            padding: 22px 0 10px 0;
            margin-top: 24px;
        }
        .social-icons {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 10px;
        }
        .social-icons a {
            color: #6dd5ed;
            font-size: 1.6em;
            transition: color 0.2s, transform 0.2s;
        }
        .social-icons a:hover,
        .social-icons a:focus {
            color: #b621fe;
            transform: scale(1.12) rotate(-3deg);
        }
        @media (max-width: 900px) {
            .category-grid, .plant-grid {
                flex-direction: column;
                align-items: center;
            }
            .category-item, .plant-item {
                width: 88vw;
            }
            .hero h1 { font-size: 2em; }
            .hero p { font-size: 1.1em; }
            .hero video { width: 90vw; }
        }
        @media (max-width: 600px) {
            header { flex-direction: column; gap: 10px; }
            .hero { padding: 45px 7px 30px 7px;}
            h2 { font-size: 1.1em;}
        }
    </style>
</head>
<body>
    <header>
        <div class="logo">Walkin'</div>
        <nav>
            <ul>
                <li><a href="#about">About Us</a></li>
                <li><a href="#terms">Terms Of Service</a></li>
                <li><a href="#refund">Refund Policy</a></li>
                <li><a href="#contact">Contact Us</a></li>
                <li><a href="#signin">Sign In</a></li>
            </ul>
        </nav>
    </header>
    <main>
        <section class="hero">
            <h1>Welcome to Walkin'</h1>
            <p>ReDefine Fashion: Wear Your Story</p>
            <video muted autoplay playsinline loop aria-label="Fashion Promo Video">
                <source src="https://cdn.shopify.com/videos/c/o/v/9954873ebd604484b1f336c036651cb4.mp4" type="video/mp4">
                Your browser does not support the video tag.
            </video>
            <a href="#shop" class="btn">Shop Now</a>
        </section>
        <section class="categories" id="shop">
            <h2>Shop by Category</h2>
            <div class="category-grid">
                <a href="#fresh-hot" class="category-item">
                    <img src="https://www.prada.com/content/dam/pradabkg_products/U/UGI/UGI302/11A6F0192/UGI302_11A6_F0192_S_OOO_SLF.jpg" alt="Fresh & Hot Collection">
                    <h3>Fresh & Hot</h3>
                </a>
                <a href="#wardrobe" class="category-item">
                    <img src="https://www.prada.com/content/dam/pradabkg_products/U/UJL/UJL72B/15DAF035G/UJL72B_15DA_F035G_S_OOO_SLF.jpg" alt="Refill your Wardrobe">
                    <h3>Refill your Wardrobe</h3>
                </a>
                <a href="#tees" class="category-item">
                    <img src="https://www.prada.com/content/dam/pradabkg_products/U/UJN/UJN861/240F0E1D/UJN861_240_F0E1D_S_232_SLF.jpg" alt="Tees Collection">
                    <h3>Tees</h3>
                </a>
                <a href="#trousers" class="category-item">
                    <img src="https://www.prada.com/content/dam/pradabkg_products/S/SPH/SPH415/148UF0D65/SPH415_148U_F0D65_S_OOO_SLF.jpg" alt="Trousers Collection">
                    <h3>Trousers</h3>
                </a>
            </div>
        </section>
        <section class="featured-plants">
            <h2>Featured</h2>
            <div class="plant-grid">
                <a href="#moonlight" class="plant-item">
                    <img src="https://www.jaywalking.in/cdn/shop/files/MOONLIGHT3.png?v=1717667289&width=1080" alt="MOONLIGHT TIE DYE">
                    <h3>MOONLIGHT TIE DYE</h3>
                </a>
                <a href="#stone" class="plant-item">
                    <img src="https://www.jaywalking.in/cdn/shop/files/stonetiedye2.png?v=1722070890&width=1080" alt="STONE TIE DYE">
                    <h3>STONE TIE DYE</h3>
                </a>
                <a href="#badly-scanned-logo" class="plant-item">
                    <img src="https://www.jaywalking.in/cdn/shop/files/logobadlyscanned4.png?v=1716973341&width=1080" alt="Badly Scanned Logo T-Shirt">
                    <h3>Badly Scanned Logo T-Shirt</h3>
                </a>
            </div>
        </section>
    </main>
    <footer>
        <p>&copy; 2024 Walkin' Ltd. All rights reserved.</p>
        <div class="social-icons">
            <a href="https://www.facebook.com" target="_blank" rel="noopener"><i class="fab fa-facebook-f"></i></a>
            <a href="https://www.twitter.com" target="_blank" rel="noopener"><i class="fab fa-twitter"></i></a>
            <a href="https://www.instagram.com" target="_blank" rel="noopener"><i class="fab fa-instagram"></i></a>
        </div>
    </footer>
</body>
</html>
